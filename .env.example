# Copy to backend/.env for local development. NEVER commit real values.
ENV=development            # development | test | production
AUTH_MODE=dev              # dev | firebase   (production requires firebase)
LLM_MODE=fake              # fake | vertex    (production requires vertex)
STORE_MODE=memory          # memory | firestore
MEDIA_MODE=memory          # memory | gcs
PRIVACY_MODE=fake          # fake (OpenCV dev detector) | gcp (Cloud Vision + DLP)

# Required when using GCP modes. TBD values: verify before setting.
GCP_PROJECT=
GCP_LOCATION=
GEMINI_MODEL=              # TBD: verify current Vertex AI model ID; never hard-code in source
MEDIA_BUCKET=

ALLOWED_ORIGINS=http://localhost:5173
ENFORCE_APP_CHECK=false
DAILY_CASE_CAP=5           # per Firebase UID
GLOBAL_DAILY_CASE_CAP=40   # across all users (anonymous ID minting brake)
RATE_LIMIT_PER_MINUTE=30
IP_RATE_LIMIT_PER_MINUTE=60
UPLOADS_ENABLED=true       # false in production until Vision+DLP verified (text-only)
FIRESTORE_DATABASE=(default)  # use a Native DB id if (default) is Datastore-mode
ENFORCE_APP_CHECK=false    # turn on after registering App Check in Firebase console
