# Copy to deploy.env.yaml and pass to:
#   gcloud run deploy opportunity-copilot-api --source . --region us-central1 \
#     --env-vars-file deploy.env.yaml
# deploy.env.yaml is gitignored (production wiring; no API keys stored here).

ENV: production
AUTH_MODE: firebase
LLM_MODE: vertex
STORE_MODE: firestore
MEDIA_MODE: gcs
PRIVACY_MODE: gcp
GCP_PROJECT: your-gcp-project
GCP_LOCATION: global
GEMINI_MODEL: gemini-2.5-flash
GEMINI_FALLBACK_MODEL: gemini-2.0-flash-001
MEDIA_BUCKET: your-project-copilot-media
FIRESTORE_DATABASE: copilot
UPLOADS_ENABLED: "false"
VISUALS_ENABLED: "false"
GEMINI_IMAGE_MODEL: gemini-nano-banana-2.1
GEMINI_IMAGE_LOCATION: global
GLOBAL_DAILY_CASE_CAP: "150"
DAILY_CASE_CAP: "3"
IP_RATE_LIMIT_PER_MINUTE: "60"
RATE_LIMIT_PER_MINUTE: "30"
ALLOWED_ORIGINS: "https://your-project.web.app,https://your-project.firebaseapp.com"
