rules_version = '2';
// All data access goes through the Cloud Run API (Admin credentials bypass these rules).
// Clients get NO direct Firestore access. Add owner-scoped read rules only if the frontend
// ever needs the Firestore SDK, and test them with the emulator first.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
